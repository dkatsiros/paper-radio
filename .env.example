# Paper Radio configuration — copy to .env and edit. Nothing here is committed.
# All values are read by paper_radio/config.py (env first, then this .env).

# --- Public serving -------------------------------------------------------
# The externally reachable HTTPS base URL where the feed server is exposed.
# Used to build the absolute feed + audio URLs podcast apps fetch. No trailing /.
PAPER_RADIO_PUBLIC_BASE=https://podcast.example.com

# Where the feed store lives: token.txt, episodes.json, feed.xml, audio/, cover.jpg
PAPER_RADIO_STORE=/srv/paper-radio/data/podcast

# --- Show (channel) metadata ---------------------------------------------
PAPER_RADIO_SHOW_TITLE=My Paper Radio
PAPER_RADIO_SHOW_DESCRIPTION=Research papers turned into short audio deep-dives.
PAPER_RADIO_SHOW_AUTHOR=Your Name
PAPER_RADIO_OWNER_NAME=Your Name
PAPER_RADIO_OWNER_EMAIL=you@example.com
PAPER_RADIO_LANGUAGE=en
# Comma-separated Apple categories (https://podcasters.apple.com/support/1691)
PAPER_RADIO_CATEGORIES=Technology,Science
PAPER_RADIO_EXPLICIT=false
PAPER_RADIO_COPYRIGHT=© Your Name
# IANA tz name used for episode publish timestamps
PAPER_RADIO_TZ=UTC

# --- Generation (NotebookLM + ffmpeg) ------------------------------------
# Path to the notebooklm CLI (default: `notebooklm` on PATH). If you installed
# it in a venv, point at that venv's bin/notebooklm.
PAPER_RADIO_NOTEBOOKLM_BIN=notebooklm
PAPER_RADIO_FFMPEG_BIN=ffmpeg
# Audio Overview style: deep-dive | brief | debate
PAPER_RADIO_AUDIO_FORMAT=deep-dive
PAPER_RADIO_MP3_BITRATE=128k
